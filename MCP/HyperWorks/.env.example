# Replace these placeholders with paths discovered on the target computer.
HYPERWORKS_HOME=<HYPERWORKS_INSTALL_ROOT>
HYPERWORKS_MCP_WORKSPACE=<WRITABLE_WORKSPACE_PATH>
# Optional; omit to use %LOCALAPPDATA%\HyperWorksMCP\bridge.json.
# HYPERWORKS_MCP_BRIDGE_CONFIG=<BRIDGE_CONFIG_PATH>
HYPERWORKS_DEFAULT_NCPU=4
HYPERWORKS_MAX_NCPU=32
PYTHONUTF8=1
