# =============================================================================
# pylumerical-mcp environment template
# =============================================================================
# Copy this file to `.env` and fill in values for your environment.
# When using the devcontainer, the contents of `.env` are loaded into the
# container automatically via Docker's `--env-file` runArg, so anything you
# put here is available at runtime to both the MCP server and the agent CLI.
# `.env` is gitignored; this template is the only one checked in.
# =============================================================================

# -----------------------------------------------------------------------------
# Ansys / Lumerical
# -----------------------------------------------------------------------------
# You can configure the license file here or in the Lumerical product.
ANSYSLMD_LICENSE_FILE=PORT@your.license.server

# By default, the GUI is shown. Set this to 1 to hide the GUI.
# The ``open_session`` tool also accepts an optional ``hide`` argument,
# that overrides the env var for that call.
LUMERICAL_HIDE_GUI=0

# -----------------------------------------------------------------------------
# MCP server runtime
# -----------------------------------------------------------------------------
# You can configure the transport, host, and port here if you want to override
# the default stdio transport.
FASTMCP_TRANSPORT = "streamable-http"
FASTMCP_HOST      = "127.0.0.1"
FASTMCP_PORT      = "8081"
