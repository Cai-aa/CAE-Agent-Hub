# Use either an absolute executable path or a command resolvable through PATH.
LAMMPS_EXE=C:\Program Files\LAMMPS\lmp.exe
OVITO_EXE=C:\Program Files\OVITO Basic\ovito.exe

# OVITO Basic GUI alone is not proof of batch-script support. Set OVITOS_EXE or
# OVITO_PYTHON to an interpreter where `import ovito` succeeds.
OVITOS_EXE=C:\Program Files\OVITO Basic\ovitos.exe
OVITO_PYTHON=C:\Python312\python.exe

# Generated job metadata and logs. This directory is ignored by Git.
ATOMISTIC_MCP_JOBS_DIR=.\jobs
