# External MCP server settings. Copy the values into your shell or MCP client;
# this file is not loaded automatically.
ANSA_MCP_BRIDGE_CONFIG=C:\Users\<USER>\AppData\Local\ANSAMCP\bridge.json
ANSA_MCP_WORKSPACE=C:\Users\<USER>\Documents\ANSAMCP\workspace

# Optional installation hints reported by get_environment. ANSA_HOME is the
# version root; ANSA_EXECUTABLE is the full path to the ANSA launcher.
ANSA_HOME=C:\Program Files\BETA_CAE_Systems\ansa_v25.1.2
ANSA_EXECUTABLE=C:\Program Files\BETA_CAE_Systems\ansa_v25.1.2\ansa64.bat

# Keep Python stdio JSON and diagnostic text UTF-8 on Windows.
PYTHONUTF8=1
